{
  "opencollection": "1.0.0",
  "info": {
    "name": "Zeal Companies Funding API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Funding",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the reserve / provider balance",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.zeal.com/reserve/balance",
            "params": [
              {
                "name": "companyID",
                "value": "",
                "type": "query",
                "description": "The Zeal companyID identifying the employer account."
              }
            ]
          },
          "docs": "Get the reserve / provider balance"
        }
      ]
    }
  ],
  "bundled": true
}