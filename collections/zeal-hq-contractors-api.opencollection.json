{
  "opencollection": "1.0.0",
  "info": {
    "name": "Zeal Companies Contractors API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Contractors",
        "type": "folder"
      },
      "items": [
